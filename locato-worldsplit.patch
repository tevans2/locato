+    void navigator.clipboard?.writeText(text).then(() => {
+      copyButton.textContent = "Copied";
+      window.setTimeout(() => { copyButton.textContent = "Copy result"; }, 1600);
+    }).catch(() => {
+      copyButton.textContent = "Copy unavailable";
+    });
