# Client-side Google Maps Embed API key for the Street View Country mode.
# Enable Maps Embed API in Google Cloud, restrict this key by HTTP referrer, then restart Vite.
VITE_GOOGLE_MAPS_EMBED_API_KEY=

# Optional separate browser key for GeoGuessr's pin map and native Street View. Enable Maps JavaScript API,
# restrict by HTTP referrer, and enable billing. Falls back to the Embed API key above.
# Solo GeoGuessr uses Google's billable Dynamic Street View SKU rather than the Embed API.
VITE_GOOGLE_MAPS_JAVASCRIPT_API_KEY=

# Optional server-side key for OpenGuessr-style daily Street View pool generation.
# Enable Street View Static API for this key, and do NOT expose it in client code.
# Metadata lookups stay on the server. Ranked games keep their chosen targets private.
GOOGLE_MAPS_STREETVIEW_METADATA_API_KEY=

# Optional discovery cache: 100 new locations per day; retain 20,000 generated entries.
# The separate checked-in 115,271-panorama catalogue is available immediately and is not capped by this setting.
STREETVIEW_DAILY_GENERATE_COUNT=100
STREETVIEW_POOL_MAX_ENTRIES=20000
STREETVIEW_REFRESH_HOURS=24
STREETVIEW_METADATA_RADIUS_METERS=10000

# Server-only ranked Street View images. Enable Street View Static API and billing.
# Can share the metadata credential; never use a VITE_ prefix for a server key.
GOOGLE_MAPS_STREETVIEW_STATIC_API_KEY=

# Private stable seed material for the ranked daily queue; generate 32+ random bytes.
# Keep this secret on the backend. Restarting the server cancels active ranked games.
RANKED_CHALLENGE_SECRET=
