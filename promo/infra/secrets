#!/usr/bin/env bash
# The promo Worker's secrets. Generates the two shared secrets once (kept in promo/.env), then stores all three in the Worker:
#   BUFFER_API_KEY       posting
#   PROMO_SERVICE_TOKEN  what the Mac tools (npm run stage / queue / content / voices) use to call the promo API
#   PROMO_ADMIN_SECRET   signs the short-lived tokens the game's admin hands to the Promo tab (the game needs it too)
set -euo pipefail
cd "$(dirname "$0")/.."
touch .env
set -a; . ./.env; set +a
gen() { python3 -c 'import secrets; print(secrets.token_hex(32))'; }
for k in PROMO_SERVICE_TOKEN PROMO_ADMIN_SECRET; do
  if [ -z "${!k:-}" ]; then echo "$k=$(gen)" >> .env; echo "✓ generated $k (in promo/.env)"; fi
done
set -a; . ./.env; set +a
: "${BUFFER_API_KEY:?BUFFER_API_KEY missing from promo/.env}"
for k in BUFFER_API_KEY PROMO_SERVICE_TOKEN PROMO_ADMIN_SECRET; do
  printf %s "${!k}" | npx wrangler secret put "$k" --config worker/wrangler.jsonc >/dev/null && echo "✓ Worker secret $k"
done
echo
echo "Last step, on the game (it restarts the game):"
echo "  fly secrets set -a locato PROMO_API_URL=https://promo.locato.quest PROMO_ADMIN_SECRET=<PROMO_ADMIN_SECRET from promo/.env>"
