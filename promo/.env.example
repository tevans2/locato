# promo/.env (gitignored). Bun scripts load it automatically.
# The promo service (promo.locato.quest): everything the Mac tools do goes through it.
PROMO_API_URL=https://promo.locato.quest
PROMO_SERVICE_TOKEN=          # made by infra/secrets
PROMO_ADMIN_SECRET=           # made by infra/secrets; the game needs it too (fly secrets)
# The voice videos use: lines in its library are reused, missing ones made with its settings and added
PROMO_VOICE_LIBRARY=george
# Posting (stored as a Worker secret by infra/secrets)
BUFFER_API_KEY=
# Cloudflare: infrastructure and deploys (see infra/README.md for the token's permissions)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
